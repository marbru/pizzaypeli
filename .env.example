# Custom settings for the docker setup

# Defaults to 8000 if unset
PORT=

# REQUIRED for running on a public server
# Gets appended to django's ALLOWED_HOSTS setting.
# Accepts a comma-separated list, e.g. CUSTOM_DOMAIN=mydomain.com,192.168.2.21
CUSTOM_DOMAIN=

# Leave empty to auto-generate (it will be persisted to data/.secret_key),
# or make your own with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Log verbosity: DEBUG, INFO, WARNING or ERROR. Defaults to INFO.
# Logs go to stdout, read them with: docker compose logs -f web
DJANGO_LOG_LEVEL=

# Docker compose restart policy. Defaults to no restart.
# Change to "unless-stopped" if you need it to behave as a daemon,
# or any other described in the spec: https://github.com/compose-spec/compose-spec/blob/main/spec.md#restart
RESTART_POLICY=